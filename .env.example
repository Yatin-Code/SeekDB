# SeekDB writes its database, TLS key, and content-addressed packages here.
SEEKDB_DATA=./data
SEEKDB_HOST=0.0.0.0
SEEKDB_PORT=8787
SEEKDB_PUBLIC_URL=https://127.0.0.1:8787
SEEKDB_ADMIN_TOKEN=
SEEKDB_MAX_PACKAGE_MB=16
SEEKDB_MAX_STORAGE_GB=200
SEEKDB_DEVICE_DAILY_GB=2
SEEKDB_DEVICE_DAILY_PACKAGES=100
SEEKDB_UPLOADS_PER_MIN=60
SEEKDB_BOOTSTRAP_INVITE=1
SEEKDB_BOOTSTRAP_INVITE_USES=100
SEEKDB_BOOTSTRAP_INVITE_TTL=30d

# Unset POOL_MODE means local-only. Supported shared modes are host and channel.
POOL_MODE=host
# Legacy compatibility: if POOL_MODE is unset, POOL_ENABLED=1 selects host.
# POOL_ENABLED=1

# Host storage backend. Channel mode always uses Telegram.
SEEKDB_STORE=fs

# Optional host API credentials. Pairing and invites are the recommended
# device path; these keys preserve compatibility with existing OpenSeek peers.
# POOL_READ_KEY=
# POOL_WRITE_KEY=

# Optional upstream pool compatibility for host mode.
# POOL_URL=https://pool.example.net
# POOL_TIMEOUT_S=2.0
# POOL_SHARE=1

# Telegram settings are needed for host + telegram or channel mode.
# SEEKDB_STORE=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_FILE=./data/telegram/session
# POOL_CHANNEL_SCAN_LIMIT=2000
# POOL_INDEX_REFRESH_S=300
# CONTRIBUTION=0
# LIBRARIAN=
# LIBRARIAN_KEY=
# LIBRARIAN_ENABLED=0

# Optional compatibility aliases use the OPENSEEK_* prefix.
